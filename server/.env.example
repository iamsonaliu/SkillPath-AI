# Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# For local MongoDB: mongodb://localhost:27017/skillpath_ai
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/skillpath_ai?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/skillpath_ai

# LLM Provider Configuration ('gemini', 'groq', or 'mock')
# In 'mock' mode, high-quality structured responses are returned locally without consuming API credits (ideal for testing & offline presentation)
LLM_PROVIDER=gemini

# Google Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Optional alternative, get from https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# Client Origin for CORS
CLIENT_URL=http://localhost:5173
